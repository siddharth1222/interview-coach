# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:3000

# ---- Database ----
# Local: mongodb://127.0.0.1:27017/ai_coach
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/ai_coach?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ai_coach

# ---- Auth ----
# Use long random strings in production (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- Gemini ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
